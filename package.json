{
  "name": "markdown-preview-gh",
  "displayName": "Markdown Preview GH",
  "description": "A polished Markdown preview with GitHub-style rendering, Mermaid diagrams, RTL support, and per-file layout control.",
  "version": "1.1.0",
  "publisher": "Abdulla-Aldosari",
  "license": "MIT",
  "icon": "images/logo256.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdulla-Aldosari/Markdown-Preview-GH.git"
  },
  "homepage": "https://github.com/Abdulla-Aldosari/Markdown-Preview-GH",
  "bugs": {
    "url": "https://github.com/Abdulla-Aldosari/Markdown-Preview-GH/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "github",
    "gfm",
    "theme"
  ],
  "galleryBanner": {
    "color": "#121314",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "dist/extension.js",
  "browser": "dist/extension-web.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The GitHub-style preview, Mermaid diagrams, and RTL rendering work in Restricted Mode. Export As, Open in Browser, and Print are disabled until the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The GitHub-style preview, Mermaid diagrams, and RTL rendering work in virtual workspaces. Export As, Open in Browser, and Print require a local file system and are unavailable there."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/mermaid-preview.js",
      "./dist/image-viewer.js",
      "./dist/block-image.js"
    ],
    "markdown.previewStyles": [
      "./dist/overrides.css",
      "./dist/preview-base.css",
      "./dist/theme-light.css",
      "./dist/theme-dark.css",
      "./dist/syntax-highlighting.css",
      "./dist/image-viewer.css",
      "./dist/block-image.css"
    ],
    "configuration": {
      "title": "Markdown Preview GH",
      "properties": {
        "markdown-preview-gh.colorTheme": {
          "type": "string",
          "order": 0,
          "description": "Determines how the preview picks its GitHub color theme.",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumItemLabels": [
            "Match the editor theme",
            "Dark",
            "Light"
          ],
          "enumDescriptions": [
            "Use the GitHub theme that matches the editor's light/dark color theme.",
            "Always display the preview with GitHub's dark theme.",
            "Always display the preview with GitHub's light theme."
          ],
          "default": "auto"
        },
        "markdown-preview-gh.contentDirection": {
          "type": "string",
          "order": 1,
          "description": "Content direction for the Markdown preview content.",
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ],
          "enumDescriptions": [
            "Left to right (default)",
            "Right to left",
            "Detect automatically from the content"
          ],
          "default": "ltr"
        },
        "markdown-preview-gh.contentWidth": {
          "type": "string",
          "order": 2,
          "description": "Content width for the Markdown preview. The `normal` value (838px) matches GitHub's content width.",
          "enum": [
            "narrow",
            "normal",
            "wide",
            "full"
          ],
          "enumDescriptions": [
            "Narrow (640px)",
            "Normal (838px) - GitHub's width",
            "Wide (1024px)",
            "Full (1200px)"
          ],
          "default": "normal"
        },
        "markdown-preview-gh.diagnosticLogging": {
          "type": "boolean",
          "order": 3,
          "description": "Enables diagnostic logging to the 'Markdown Preview GH' output channel. Useful when troubleshooting the extension.",
          "default": false
        },
        "markdown-preview-gh.blockImageScale": {
          "type": "number",
          "order": 5,
          "markdownDescription": "Scale of the PNG images made by the `Copy This ... As PNG` commands: how many image pixels one pixel of the block becomes. `1` is the actual size of the block; larger values give a bigger, sharper image. The scale does not follow VS Code zoom (`window.zoomLevel`) or your display scaling: if you work zoomed in, the image can look smaller than the preview on your screen, so choose a larger scale. A block too large for the chosen scale is made at the next smaller scale that fits.",
          "enum": [
            1,
            1.5,
            2,
            2.5,
            3
          ],
          "enumDescriptions": [
            "1x - the actual size (default)",
            "1.5x",
            "2x - twice the size, sharper on high-density screens",
            "2.5x",
            "3x"
          ],
          "default": 1
        },
        "markdown-preview-gh.blockImageRadius": {
          "type": "number",
          "order": 6,
          "markdownDescription": "Corner radius of the PNG images made by the `Copy This ... As PNG` commands, in pixels of the block. `0` keeps square corners; the value is limited to the 16-pixel padding around the block so the content is never cut.",
          "minimum": 0,
          "maximum": 16,
          "default": 10
        },
        "markdown-preview-gh.export.browserPath": {
          "type": "string",
          "order": 4,
          "scope": "machine",
          "markdownDescription": "Full path of the Chromium-based browser (Edge, Chrome, or Chromium) used by `Export As... > PDF`. Leave empty to detect an installed browser automatically. In a remote window the path is on the remote machine.",
          "default": ""
        }
      }
    },
    "commands": [
      {
        "command": "markdown-preview-gh.preferences.width.narrow",
        "title": "Width Narrow",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.narrow.checked",
        "title": "Width Narrow ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.normal",
        "title": "Width Normal",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.normal.checked",
        "title": "Width Normal ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.wide",
        "title": "Width Wide",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.wide.checked",
        "title": "Width Wide ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.full",
        "title": "Width Full",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.width.full.checked",
        "title": "Width Full ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.direction.auto",
        "title": "Direction Auto",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.direction.auto.checked",
        "title": "Direction Auto ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.direction.ltr",
        "title": "Direction LTR",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.direction.ltr.checked",
        "title": "Direction LTR ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.direction.rtl",
        "title": "Direction RTL",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.direction.rtl.checked",
        "title": "Direction RTL ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.theme.auto",
        "title": "Theme Auto",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.theme.auto.checked",
        "title": "Theme Auto ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.theme.dark",
        "title": "Theme Dark",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.theme.dark.checked",
        "title": "Theme Dark ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.theme.light",
        "title": "Theme Light",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.preferences.theme.light.checked",
        "title": "Theme Light ✔",
        "category": "Markdown Preview GH: Preferences"
      },
      {
        "command": "markdown-preview-gh.resetPreferences",
        "title": "Reset Preferences for this file",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.openInBrowser",
        "title": "Open in Browser",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.print",
        "title": "Print...",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.exportHtmlLight",
        "title": "HTML Light Theme",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.exportHtmlDark",
        "title": "HTML Dark Theme",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.exportPdf",
        "title": "PDF",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.copyTableAsPng",
        "title": "Copy This Table As PNG",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.copyCodeBlockAsPng",
        "title": "Copy This Code Block As PNG",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.copyDiagramAsPng",
        "title": "Copy This Diagram As PNG",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.copySectionAsPng",
        "title": "Copy This Section As PNG",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.openFileOnGitHub",
        "title": "Open File on GitHub",
        "category": "Markdown Preview GH"
      }
    ],
    "submenus": [
      {
        "id": "markdown-preview-gh.exportAs",
        "label": "Export As..."
      },
      {
        "id": "markdown-preview-gh.preferences",
        "label": "Preferences"
      }
    ],
    "menus": {
      "markdown-preview-gh.exportAs": [
        {
          "command": "markdown-preview-gh.exportHtmlLight",
          "when": "isWorkspaceTrusted",
          "group": "1_export@1"
        },
        {
          "command": "markdown-preview-gh.exportHtmlDark",
          "when": "isWorkspaceTrusted",
          "group": "1_export@2"
        },
        {
          "command": "markdown-preview-gh.exportPdf",
          "when": "!isWeb && isWorkspaceTrusted",
          "group": "1_export@3"
        }
      ],
      "commandPalette": [
        {
          "command": "markdown-preview-gh.preferences.width.narrow",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.narrow.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.normal",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.normal.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.wide",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.wide.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.full",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.width.full.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.auto",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.auto.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.ltr",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.ltr.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.rtl",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.rtl.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.auto",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.auto.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.dark",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.dark.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.light",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.light.checked",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.resetPreferences",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.openInBrowser",
          "when": "editorLangId == markdown && !isWeb && isWorkspaceTrusted"
        },
        {
          "command": "markdown-preview-gh.print",
          "when": "editorLangId == markdown && !isWeb && isWorkspaceTrusted"
        },
        {
          "command": "markdown-preview-gh.exportHtmlLight",
          "when": "editorLangId == markdown && isWorkspaceTrusted"
        },
        {
          "command": "markdown-preview-gh.exportHtmlDark",
          "when": "editorLangId == markdown && isWorkspaceTrusted"
        },
        {
          "command": "markdown-preview-gh.exportPdf",
          "when": "editorLangId == markdown && !isWeb && isWorkspaceTrusted"
        },
        {
          "command": "markdown-preview-gh.copyTableAsPng",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.copyCodeBlockAsPng",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.copyDiagramAsPng",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.copySectionAsPng",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "markdown-preview-gh.copyTableAsPng",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && mpghBlock == 'table' && markdownPreviewGh.canCopyBlockImage",
          "group": "z_gmpBlock@1"
        },
        {
          "command": "markdown-preview-gh.copyCodeBlockAsPng",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && mpghBlock == 'code' && markdownPreviewGh.canCopyBlockImage",
          "group": "z_gmpBlock@2"
        },
        {
          "command": "markdown-preview-gh.copyDiagramAsPng",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && mpghBlock == 'diagram' && markdownPreviewGh.canCopyBlockImage",
          "group": "z_gmpBlock@3"
        },
        {
          "command": "markdown-preview-gh.copySectionAsPng",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && mpghBlock == 'section' && markdownPreviewGh.canCopyBlockImage",
          "group": "z_gmpBlock@4"
        },
        {
          "command": "markdown-preview-gh.openInBrowser",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && !isWeb && isWorkspaceTrusted",
          "group": "z_gmpExport@1"
        },
        {
          "command": "markdown-preview-gh.print",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && !isWeb && isWorkspaceTrusted",
          "group": "z_gmpExport@2"
        },
        {
          "submenu": "markdown-preview-gh.exportAs",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && isWorkspaceTrusted",
          "group": "z_gmpExport@3"
        },
        {
          "submenu": "markdown-preview-gh.preferences",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpPrefs@1"
        },
        {
          "command": "markdown-preview-gh.resetPreferences",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpPrefs@2"
        },
        {
          "command": "markdown-preview-gh.openFileOnGitHub",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && !isWeb && markdownPreviewGh.isGitHubRepo",
          "group": "z_gmpSource@1"
        }
      ],
      "markdown-preview-gh.preferences": [
        {
          "command": "markdown-preview-gh.preferences.width.narrow",
          "when": "mpghWidth != 'narrow'",
          "group": "1_width@1"
        },
        {
          "command": "markdown-preview-gh.preferences.width.narrow.checked",
          "when": "mpghWidth == 'narrow'",
          "group": "1_width@1"
        },
        {
          "command": "markdown-preview-gh.preferences.width.normal",
          "when": "mpghWidth != 'normal'",
          "group": "1_width@2"
        },
        {
          "command": "markdown-preview-gh.preferences.width.normal.checked",
          "when": "mpghWidth == 'normal'",
          "group": "1_width@2"
        },
        {
          "command": "markdown-preview-gh.preferences.width.wide",
          "when": "mpghWidth != 'wide'",
          "group": "1_width@3"
        },
        {
          "command": "markdown-preview-gh.preferences.width.wide.checked",
          "when": "mpghWidth == 'wide'",
          "group": "1_width@3"
        },
        {
          "command": "markdown-preview-gh.preferences.width.full",
          "when": "mpghWidth != 'full'",
          "group": "1_width@4"
        },
        {
          "command": "markdown-preview-gh.preferences.width.full.checked",
          "when": "mpghWidth == 'full'",
          "group": "1_width@4"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.auto",
          "when": "mpghDirection != 'auto'",
          "group": "2_direction@1"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.auto.checked",
          "when": "mpghDirection == 'auto'",
          "group": "2_direction@1"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.ltr",
          "when": "mpghDirection != 'ltr'",
          "group": "2_direction@2"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.ltr.checked",
          "when": "mpghDirection == 'ltr'",
          "group": "2_direction@2"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.rtl",
          "when": "mpghDirection != 'rtl'",
          "group": "2_direction@3"
        },
        {
          "command": "markdown-preview-gh.preferences.direction.rtl.checked",
          "when": "mpghDirection == 'rtl'",
          "group": "2_direction@3"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.auto",
          "when": "mpghTheme != 'auto'",
          "group": "3_theme@1"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.auto.checked",
          "when": "mpghTheme == 'auto'",
          "group": "3_theme@1"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.dark",
          "when": "mpghTheme != 'dark'",
          "group": "3_theme@2"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.dark.checked",
          "when": "mpghTheme == 'dark'",
          "group": "3_theme@2"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.light",
          "when": "mpghTheme != 'light'",
          "group": "3_theme@3"
        },
        {
          "command": "markdown-preview-gh.preferences.theme.light.checked",
          "when": "mpghTheme == 'light'",
          "group": "3_theme@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./build/generate-theme-css.mts && node ./build/bundle.mts --production",
    "build": "node ./build/generate-theme-css.mts && node ./build/bundle.mts",
    "watch": "node ./build/bundle.mts --watch",
    "changelog": "git-cliff -o CHANGELOG.md",
    "package": "vsce package",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "sync:themes": "node ./build/sync-themes.mts",
    "audit:themes": "node ./build/theme-audit/audit.mts",
    "test": "node --test \"test/**/*.test.mts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:web": "vscode-test-web --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "12.2.3",
    "@types/node": "^22.5.5",
    "@types/vscode": "1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdown-it": "12.3.2",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "mermaid": "11.16.1"
  }
}
