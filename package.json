{
  "name": "markdown-preview-gh",
  "displayName": "Markdown Preview GH",
  "description": "A polished Markdown preview with GitHub-style rendering, Mermaid diagrams, RTL support, and per-file layout control.",
  "version": "1.1.0",
  "publisher": "Abdulla-Aldosari",
  "license": "MIT",
  "icon": "images/logo256.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdulla-Aldosari/Markdown-Preview-GH.git"
  },
  "homepage": "https://github.com/Abdulla-Aldosari/Markdown-Preview-GH",
  "bugs": {
    "url": "https://github.com/Abdulla-Aldosari/Markdown-Preview-GH/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "github",
    "gfm",
    "theme"
  ],
  "galleryBanner": {
    "color": "#121314",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "dist/extension.js",
  "browser": "dist/extension-web.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/mermaid-preview.js",
      "./dist/image-viewer.js"
    ],
    "markdown.previewStyles": [
      "./dist/overrides.css",
      "./dist/preview-base.css",
      "./dist/theme-light.css",
      "./dist/theme-dark.css",
      "./dist/syntax-highlighting.css",
      "./dist/image-viewer.css"
    ],
    "configuration": {
      "title": "Markdown Preview GH",
      "properties": {
        "markdown-preview-gh.colorTheme": {
          "type": "string",
          "order": 0,
          "description": "Determines how the preview picks its GitHub color theme.",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumItemLabels": [
            "Match the editor theme",
            "Dark",
            "Light"
          ],
          "enumDescriptions": [
            "Use the GitHub theme that matches the editor's light/dark color theme.",
            "Always display the preview with GitHub's dark theme.",
            "Always display the preview with GitHub's light theme."
          ],
          "default": "auto"
        },
        "markdown-preview-gh.contentDirection": {
          "type": "string",
          "order": 1,
          "description": "Content direction for the Markdown preview content.",
          "enum": [
            "ltr",
            "rtl",
            "auto"
          ],
          "enumDescriptions": [
            "Left to right (default)",
            "Right to left",
            "Detect automatically from the content"
          ],
          "default": "ltr"
        },
        "markdown-preview-gh.contentWidth": {
          "type": "string",
          "order": 2,
          "description": "Content width for the Markdown preview. The `normal` value (838px) matches GitHub's content width.",
          "enum": [
            "narrow",
            "normal",
            "wide",
            "full"
          ],
          "enumDescriptions": [
            "Narrow (640px)",
            "Normal (838px) - GitHub's width",
            "Wide (1024px)",
            "Full (1200px)"
          ],
          "default": "normal"
        },
        "markdown-preview-gh.diagnosticLogging": {
          "type": "boolean",
          "order": 3,
          "description": "Enables diagnostic logging to the 'Markdown Preview GH' output channel. Useful when troubleshooting the extension.",
          "default": false
        }
      }
    },
    "commands": [
      {
        "command": "markdown-preview-gh.setContentDirection",
        "title": "Content Direction...",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.setContentWidth",
        "title": "Content Width...",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.resetPreferences",
        "title": "Reset Preferences for this file",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.setColorMode",
        "title": "Theme...",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.openInBrowser",
        "title": "Open in Browser",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.print",
        "title": "Print...",
        "category": "Markdown Preview GH"
      },
      {
        "command": "markdown-preview-gh.exportHtmlLight",
        "title": "HTML Light Theme",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.exportHtmlDark",
        "title": "HTML Dark Theme",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.exportPdf",
        "title": "PDF",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.exportPng",
        "title": "PNG",
        "category": "Markdown Preview GH: Export As"
      },
      {
        "command": "markdown-preview-gh.openFileOnGitHub",
        "title": "Open File on GitHub",
        "category": "Markdown Preview GH"
      }
    ],
    "submenus": [
      {
        "id": "markdown-preview-gh.exportAs",
        "label": "Export As..."
      }
    ],
    "menus": {
      "markdown-preview-gh.exportAs": [
        {
          "command": "markdown-preview-gh.exportHtmlLight",
          "group": "1_export@1"
        },
        {
          "command": "markdown-preview-gh.exportHtmlDark",
          "group": "1_export@2"
        },
        {
          "command": "markdown-preview-gh.exportPdf",
          "when": "false",
          "group": "1_export@3"
        },
        {
          "command": "markdown-preview-gh.exportPng",
          "when": "false",
          "group": "1_export@4"
        }
      ],
      "commandPalette": [
        {
          "command": "markdown-preview-gh.setContentDirection",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.setContentWidth",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.resetPreferences",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.setColorMode",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.openInBrowser",
          "when": "editorLangId == markdown && !isWeb"
        },
        {
          "command": "markdown-preview-gh.print",
          "when": "editorLangId == markdown && !isWeb"
        },
        {
          "command": "markdown-preview-gh.exportHtmlLight",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdown-preview-gh.exportHtmlDark",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdown-preview-gh.exportPdf",
          "when": "false"
        },
        {
          "command": "markdown-preview-gh.exportPng",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "markdown-preview-gh.openInBrowser",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && !isWeb",
          "group": "z_gmpExport@1"
        },
        {
          "command": "markdown-preview-gh.print",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && !isWeb",
          "group": "z_gmpExport@2"
        },
        {
          "submenu": "markdown-preview-gh.exportAs",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpExport@3"
        },
        {
          "command": "markdown-preview-gh.setContentWidth",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpPrefs@1"
        },
        {
          "command": "markdown-preview-gh.setContentDirection",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpPrefs@2"
        },
        {
          "command": "markdown-preview-gh.setColorMode",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpPrefs@3"
        },
        {
          "command": "markdown-preview-gh.resetPreferences",
          "when": "webviewId == 'markdown.preview' && !mpghViewer",
          "group": "z_gmpPrefs@4"
        },
        {
          "command": "markdown-preview-gh.openFileOnGitHub",
          "when": "webviewId == 'markdown.preview' && !mpghViewer && !isWeb && markdownPreviewGh.isGitHubRepo",
          "group": "z_gmpSource@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./build/generate-theme-css.mts && node ./build/bundle.mts --production",
    "build": "node ./build/generate-theme-css.mts && node ./build/bundle.mts",
    "watch": "node ./build/bundle.mts --watch",
    "changelog": "git-cliff -o CHANGELOG.md",
    "package": "vsce package",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "sync:themes": "node ./build/sync-themes.mts",
    "audit:themes": "node ./build/theme-audit/audit.mts",
    "test": "node --test \"test/**/*.test.mts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "12.2.3",
    "@types/node": "^22.5.5",
    "@types/vscode": "1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdown-it": "12.3.2",
    "postcss": "8.5.30",
    "prettier": "^3.9.10",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "mermaid": "11.16.1"
  }
}
